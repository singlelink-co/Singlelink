# LaunchLinks Environment Variables Template
# Copy this file to .env and fill in your specific values.

# --- Database Configuration ---
# Used to connect to your MySQL database.
DB_DATABASE=your_database_name
DB_PORT=3306
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password
# Alternatively, you can use a single DB_URL (if your ORM/client supports it, e.g., for Prisma)
# DB_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# --- Site Metadata ---
# These are used for SEO and how your site appears in previews.
META_TITLE=LaunchLinks - Your Links, One Place
META_DESC=The ultimate platform to consolidate all your links and content.
META_IMG=https://yourdomain.com/og-image.png # URL to your site's Open Graph image

# --- Branding ---
# Set to "true" to show LaunchLinks branding, "false" to hide (if supported by your plan).
BRANDING=true

# --- Legacy Authentication (Singlelink Original) ---
# These were used by the original Singlelink. Review if still needed or if custom scripts depend on them.
# For NextAuth.js, NEXTAUTH_SECRET is used.
SECRET=your_very_strong_secret_for_legacy_jwt # Legacy: used for old JWT logic if any remains
PASSWORD=your_admin_password_for_legacy_login # Legacy: used for old direct password login if any remains

# --- NextAuth.js Configuration ---
# Used for user authentication.
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_strong_secret
# For production, set this to your site's canonical URL (e.g., https://yourdomain.com)
# For local development, http://localhost:3000 is fine.
NEXTAUTH_URL=https://yourdomain.com

# --- Stripe Configuration ---
# Obtain these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Publishable key (client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_yourstrippublishablekey
# Secret key (server-side, keep this very secure!)
STRIPE_SECRET_KEY=sk_test_yourstripesecretkey
# Webhook secret (server-side, for verifying webhook events)
# Get this from your Stripe Dashboard when setting up a webhook endpoint (e.g., yourdomain.com/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_yourstripewebhooksecret

# --- Stripe Price IDs ---
# Create Products and their Prices in your Stripe Dashboard first.
# These IDs link your frontend plans to Stripe prices.
# Example: price_1Lxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PRO_PLAN_PRICE_ID=price_yourproplanid
NEXT_PUBLIC_STRIPE_BUSINESS_PLAN_PRICE_ID=price_yourbusinessplanid
