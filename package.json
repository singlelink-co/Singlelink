  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:docker": "docker build -t launchlinks-app ./docker", # Updated image name
    "start": "next start",
    "test": "jest",
    "lint": "next lint",
    "generate": "graphql-codegen --config codegen.yml --watch",
    "postinstall": "",
    "migrate": "npx migrate-mysql",
    "db:migrate": "npx migrate-mysql",
    "boot:app": "docker run --name launchlinks-app -p 3000:3000 launchlinks-app", # Simplified, assumes local image launchlinks-app
    "boot:db": "docker pull mysql | docker run --name launchlinks-mysql -e MYSQL_DATABASE=launchlinks -p 3306:3306 -e MYSQL_ROOT_PASSWORD=launchlinks-secret -d mysql:latest" # Changed DB name and example password
